{
  "id": "anant-barlota/webhook",
  "name": "Webhook",
  "version": "0.2.0",
  "api": "girvi/v1",
  "description": "Posts loan events to a URL you choose, signed, so a spreadsheet, Zapier, Make or your own service can act on them.",
  "author": "Anant Barlota",
  "events": ["loan.created", "payment.received", "loan.redeemed"],
  "fields": ["customer.name", "customer.phone"],
  "http_hosts": ["{setting:url}"],
  "settings": [
    {"key": "url", "title": "Webhook URL", "required": true},
    {"key": "signing_secret", "title": "Signing secret", "secret": true},
    {"key": "include_customer_details", "title": "Include customer names and phone numbers", "type": "boolean", "default": "true"},
    {"key": "auth_header", "title": "Authorization header", "secret": true, "advanced": true},
    {"key": "allow_plain_http", "title": "Allow plain http outside my network", "type": "boolean", "default": "false", "advanced": true}
  ]
}
